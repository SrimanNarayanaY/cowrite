DB_HOST=your-db-host.example.com
DB_PORT=5432
DB_NAME=cowrite
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
# require for hosted Postgres (TLS), disable for a local Docker Postgres
DB_SSLMODE=require

# Min 32 chars. Generate: openssl rand -base64 48
JWT_SECRET=change-me-this-is-only-a-placeholder-secret
# Access token lifetime in ms (3600000 = 1 hour)
JWT_EXPIRATION=3600000
